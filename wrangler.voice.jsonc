{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duotranslate-voice-test",
  "main": "cloudflare/voice-worker-test.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "services": [{ "binding": "DUO_ACCESS_SERVICE", "service": "duotranslate-ai" }],
  "ratelimits": [
    {
      "name": "VOICE_LIMITER",
      "namespace_id": "1428",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
